{
  "name": "@togetherweown/paperclip-plugin-github-broker",
  "version": "0.2.0",
  "private": true,
  "description": "Per-agent GitHub App credential broker: eight read-only tools plus one allowlisted staging workflow-dispatch write (devops profile only)",
  "type": "module",
  "engines": { "node": ">=24.11.0 <25" },
  "files": ["dist", "README.md", "THREAT-MODEL.md", "ACCEPTANCE.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout=30000 test/*.test.mjs"
  },
  "dependencies": { "@paperclipai/plugin-sdk": "2026.1023.0" },
  "paperclipPlugin": {
    "manifest": "./dist/plugins/github-broker/src/manifest.js",
    "worker": "./dist/plugins/github-broker/src/worker.js"
  }
}
