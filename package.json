{
  "name": "agent-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "plugins/*"],
  "engines": {"node": ">=24.11.0 <25"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build --workspaces --if-present && node --test --test-timeout=30000 test/*.test.mjs && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "work-supply": "node packages/work-supply/src/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
